{
  "name": "@dita/desktop",
  "version": "1.5.0",
  "private": true,
  "description": "DITAEditor Desktop — Lightweight DITA 1.3 structured authoring workbench for macOS and Windows",
  "license": "MIT",
  "type": "module",
  "main": "dist/main.mjs",
  "scripts": {
    "postinstall": "node scripts/ensure-electron.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "dev": "node scripts/ensure-electron.mjs && node scripts/build.mjs && electron .",
    "stage": "node scripts/stage.mjs",
    "dist": "node scripts/stage.mjs && electron-builder --config electron-builder.yml --publish never",
    "dist:mac": "node scripts/stage.mjs && electron-builder --config electron-builder.yml --mac --arm64 --publish never",
    "dist:win": "node scripts/stage.mjs && electron-builder --config electron-builder.yml --win --x64 --publish never"
  },
  "dependencies": {
    "@dita/api": "workspace:*",
    "better-sqlite3": "^13.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "electron": "^35.2.0",
    "electron-builder": "^26.18.1",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
