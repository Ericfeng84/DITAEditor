<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE troubleshooting PUBLIC "-//OASIS//DTD DITA 1.3 Troubleshooting//EN" "troubleshooting.dtd">
<troubleshooting id="ts_conn_refused" xml:lang="zh-CN" xmlns:ditaarch="http://dita.oasis-open.org/architecture/2005/" ditaarch:DITAArchVersion="1.3">
  <title>排查校验服务连接被拒绝错误</title>
  <troublebody>
    <condition id="cond_err">
      <p>保存文档时底部问题面板提示 <systemoutput translate="no" dir="ltr">ECONNREFUSED 127.0.0.1:8090</systemoutput>。</p>
    </condition>
    <troubleSolution>
      <cause>
        <title>可能原因</title>
        <p>常驻 Java Worker 容器尚未启动完成，或监听端口与 API 环境变量不一致。</p>
      </cause>
      <remedy>
        <title>解决步骤</title>
        <responsibleParty>运维工程师</responsibleParty>
        <steps-unordered>
          <step>
            <cmd>检查容器状态：<cmdname>docker compose ps</cmdname>。</cmd>
          </step>
          <step>
            <cmd>查看 <filepath>.env</filepath> 中的 <varname>DITA_WORKER_URL</varname> 配置。</cmd>
          </step>
        </steps-unordered>
      </remedy>
    </troubleSolution>
  </troublebody>
</troubleshooting>
