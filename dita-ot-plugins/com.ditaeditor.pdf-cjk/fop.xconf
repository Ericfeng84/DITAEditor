<?xml version="1.0" encoding="UTF-8"?>
<!--
  FOP configuration used by DITAEditor's PDF publishing path.

  DITAEditor passes this file explicitly:
    dita input=... format=pdf args.fo.userconfig=<this file>

  This file is the *fallback* table, aimed at Noto CJK installed as single-face OTF files
  (the Google "language-specific OTF" download, macOS/Windows manual installs). Adobe FOP 2.9
  cannot embed a TTC/OTC collection that stores CFF outlines — it picks its TrueType parser from
  the file header (`OFFontLoader.read` only chooses `OTFFile` for a literal `OTTO` header) and
  then aborts with "'loca' table not found" — and Debian's `fonts-noto-cjk` ships exactly those
  collections. `@dita/api` therefore rebuilds a job-local configuration from the installed fonts:
  it reads each face's name table, materialises the needed face as a standalone font file under
  `<job>/fonts`, and replaces both `<font-base>` and the `<fonts>` block below.

  Two details that break a hand-written table:
  - `sub-font` must equal a face's full name (name table ID 4) exactly, and that name carries the
    weight: `NotoSansCJK-Bold.ttc` reports `Noto Sans CJK SC Bold`, not `Noto Sans CJK SC`.
  - Debian ships the `Noto Sans Mono CJK *` faces inside `NotoSansCJK-*.ttc`; there is no
    `NotoSansMonoCJK-*.ttc` file.

  For local macOS or Windows development, set DITAEDITOR_FOP_XCONF to a copy with a matching
  font-base path, or set DITAEDITOR_NOTO_CJK_DIR and let the API generate the configuration.
-->
<fop version="1.1">
  <use-cache>false</use-cache>
  <font-base>/usr/share/fonts/opentype/noto</font-base>
  <source-resolution>72</source-resolution>
  <target-resolution>72</target-resolution>
  <strict-configuration>false</strict-configuration>
  <strict-validation>false</strict-validation>
  <renderers>
    <renderer mime="application/pdf">
      <filterList>
        <value>flate</value>
      </filterList>
      <fonts>
        <font embed-url="NotoSansCJKsc-Regular.otf" kerning="yes">
          <font-triplet name="Noto Sans CJK SC" style="normal" weight="normal"/>
        </font>
        <font embed-url="NotoSansCJKsc-Bold.otf" kerning="yes">
          <font-triplet name="Noto Sans CJK SC" style="normal" weight="bold"/>
        </font>
        <font embed-url="NotoSansCJKsc-Regular.otf" kerning="yes">
          <font-triplet name="Noto Sans CJK SC" style="italic" weight="normal"/>
        </font>
        <font embed-url="NotoSansCJKsc-Bold.otf" kerning="yes">
          <font-triplet name="Noto Sans CJK SC" style="italic" weight="bold"/>
        </font>
        <font embed-url="NotoSerifCJKsc-Regular.otf" kerning="yes">
          <font-triplet name="Noto Serif CJK SC" style="normal" weight="normal"/>
        </font>
        <font embed-url="NotoSerifCJKsc-Bold.otf" kerning="yes">
          <font-triplet name="Noto Serif CJK SC" style="normal" weight="bold"/>
        </font>
        <font embed-url="NotoSerifCJKsc-Regular.otf" kerning="yes">
          <font-triplet name="Noto Serif CJK SC" style="italic" weight="normal"/>
        </font>
        <font embed-url="NotoSerifCJKsc-Bold.otf" kerning="yes">
          <font-triplet name="Noto Serif CJK SC" style="italic" weight="bold"/>
        </font>
        <font embed-url="NotoSansMonoCJKsc-Regular.otf" kerning="yes">
          <font-triplet name="Noto Sans Mono CJK SC" style="normal" weight="normal"/>
        </font>
        <font embed-url="NotoSansMonoCJKsc-Bold.otf" kerning="yes">
          <font-triplet name="Noto Sans Mono CJK SC" style="normal" weight="bold"/>
        </font>
        <font embed-url="NotoSansMonoCJKsc-Regular.otf" kerning="yes">
          <font-triplet name="Noto Sans Mono CJK SC" style="italic" weight="normal"/>
        </font>
        <font embed-url="NotoSansMonoCJKsc-Bold.otf" kerning="yes">
          <font-triplet name="Noto Sans Mono CJK SC" style="italic" weight="bold"/>
        </font>
      </fonts>
    </renderer>
  </renderers>
</fop>
