<?xml version="1.0" encoding="UTF-8"?>
<!--
  FOP configuration used by DITAEditor's PDF publishing path.

  DITAEditor passes this file explicitly:
    dita input=... format=pdf args.fo.userconfig=<this file>

  Docker images based on Debian install `fonts-noto-cjk` and `fonts-noto-cjk-extra`,
  which place the TTC collections in the font-base directory below. For local macOS
  or Windows development, set DITAEDITOR_FOP_XCONF to a copy with a matching
  font-base path, or set DITAEDITOR_NOTO_CJK_DIR and let the API generate the config.
-->
<fop version="1.1">
  <use-cache>false</use-cache>
  <font-base>/usr/share/fonts/opentype/noto</font-base>
  <source-resolution>72</source-resolution>
  <target-resolution>72</target-resolution>
  <strict-configuration>false</strict-configuration>
  <strict-validation>false</strict-validation>
  <renderers>
    <renderer mime="application/pdf">
      <filterList>
        <value>flate</value>
      </filterList>
      <fonts>
        <font embed-url="NotoSansCJK-Regular.ttc" kerning="yes" sub-font="Noto Sans CJK SC">
          <font-triplet name="Noto Sans CJK SC" style="normal" weight="normal"/>
        </font>
        <font embed-url="NotoSansCJK-Bold.ttc" kerning="yes" sub-font="Noto Sans CJK SC">
          <font-triplet name="Noto Sans CJK SC" style="normal" weight="bold"/>
        </font>
        <font embed-url="NotoSansCJK-Regular.ttc" kerning="yes" sub-font="Noto Sans CJK SC">
          <font-triplet name="Noto Sans CJK SC" style="italic" weight="normal"/>
        </font>
        <font embed-url="NotoSerifCJK-Regular.ttc" kerning="yes" sub-font="Noto Serif CJK SC">
          <font-triplet name="Noto Serif CJK SC" style="normal" weight="normal"/>
        </font>
        <font embed-url="NotoSerifCJK-Bold.ttc" kerning="yes" sub-font="Noto Serif CJK SC">
          <font-triplet name="Noto Serif CJK SC" style="normal" weight="bold"/>
        </font>
        <font embed-url="NotoSerifCJK-Regular.ttc" kerning="yes" sub-font="Noto Serif CJK SC">
          <font-triplet name="Noto Serif CJK SC" style="italic" weight="normal"/>
        </font>
        <font embed-url="NotoSansMonoCJK-Regular.ttc" kerning="yes" sub-font="Noto Sans Mono CJK SC">
          <font-triplet name="Noto Sans Mono CJK SC" style="normal" weight="normal"/>
        </font>
        <font embed-url="NotoSansMonoCJK-Bold.ttc" kerning="yes" sub-font="Noto Sans Mono CJK SC">
          <font-triplet name="Noto Sans Mono CJK SC" style="normal" weight="bold"/>
        </font>
      </fonts>
    </renderer>
  </renderers>
</fop>
