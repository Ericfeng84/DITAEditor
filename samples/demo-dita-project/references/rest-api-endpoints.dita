<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="ref_rest_api" xml:lang="zh-CN">
  <title>工作台 REST API 端点参考</title>
  <shortdesc>Fastify 本地工作区文件读写、资产上传与诊断校验接口概览。</shortdesc>
  <refbody>
    <section id="sec_endpoints">
      <title>Phase 2 文件与工作区端点</title>
      <simpletable id="st_workspace_api" relcolwidth="1* 2* 3*">
        <sthead>
          <stentry>Method</stentry>
          <stentry>Path</stentry>
          <stentry>Description</stentry>
        </sthead>
        <strow>
          <stentry><codeph>GET</codeph></stentry>
          <stentry><apiname>/api/workspace</apiname></stentry>
          <stentry>扫描当前项目文件树、Map 列表与 Topic 标题索引。</stentry>
        </strow>
        <strow>
          <stentry><codeph>PUT</codeph></stentry>
          <stentry><apiname>/api/files/content</apiname></stentry>
          <stentry>保存 Topic 或 Map XML 内容并校验良构性。</stentry>
        </strow>
        <strow>
          <stentry><codeph>POST</codeph></stentry>
          <stentry><apiname>/api/assets/upload</apiname></stentry>
          <stentry>上传图片资产并返回相对引用路径 <codeph>relativeHref</codeph>。</stentry>
        </strow>
        <strow>
          <stentry><codeph>GET</codeph></stentry>
          <stentry><apiname>/api/diagnostics</apiname></stentry>
          <stentry>检查 XML 良构、Map 断链与循环 <codeph>&lt;mapref&gt;</codeph> 引用。</stentry>
        </strow>
      </simpletable>
    </section>
  </refbody>
</reference>
